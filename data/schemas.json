{
  "source-pr": {
    "required": [
      "id",
      "repo",
      "pr",
      "title",
      "author",
      "date",
      "url",
      "source_category",
      "architectures",
      "architecture_disposition",
      "architecture_evidence",
      "tags",
      "techniques",
      "hardware_features",
      "kernel_types",
      "languages",
      "captured_at",
      "status",
      "inclusion_reason",
      "scope_disposition",
      "scope_evidence",
      "body_contract",
      "upstream_body_locator",
      "upstream_body_sha256",
      "upstream_excerpt_sha256",
      "upstream_files_sha256"
    ],
    "optional": [
      "merge_sha",
      "description",
      "changed_paths",
      "changed_files_count",
      "changed_files_enumerated_count",
      "changed_files_listing_complete",
      "changed_files_evidence_count",
      "changed_files_evidence_complete",
      "changed_files_evidence_method",
      "changed_files_evidence_receipt",
      "changed_paths_complete",
      "upstream_patches_complete",
      "artifact_dir"
    ],
    "disallow_peer_of_artifact_dir": [
      "diff_path",
      "code_path",
      "patch_path",
      "key_file_path"
    ],
    "constraints": {
      "source_category": "upstream-code",
      "status": [
        "open",
        "merged",
        "closed"
      ],
      "merge_sha_required_when": "status == merged"
    }
  },
  "source-doc": {
    "required": [
      "id",
      "title",
      "url",
      "source_category",
      "architectures",
      "tags",
      "retrieved_at"
    ],
    "optional": [
      "author",
      "description"
    ],
    "constraints": {
      "source_category": [
        "official-doc",
        "paper"
      ]
    }
  },
  "source-blog": {
    "required": [
      "id",
      "title",
      "author",
      "url",
      "source_category",
      "architectures",
      "tags",
      "retrieved_at"
    ],
    "optional": [
      "description",
      "artifact_dir"
    ],
    "disallow_peer_of_artifact_dir": [
      "code_path",
      "code_dir"
    ],
    "constraints": {
      "source_category": [
        "benchmark-blog",
        "community-note"
      ]
    }
  },
  "source-contest": {
    "required": [
      "id",
      "title",
      "source_category",
      "architectures",
      "tags"
    ],
    "optional": [
      "url",
      "description",
      "problem_number",
      "track",
      "submissions",
      "artifact_dir"
    ],
    "disallow_peer_of_artifact_dir": [
      "code_path"
    ],
    "submissions_schema": {
      "required": [
        "rank",
        "participant",
        "submission_truth"
      ],
      "optional": [
        "score",
        "technique",
        "code_path",
        "code_unavailable_reason"
      ],
      "constraints": {
        "submission_truth": [
          "official-submission",
          "author-published-posthoc",
          "reconstructed-from-blog",
          "unavailable"
        ],
        "code_path_required_when": "submission_truth != unavailable",
        "code_unavailable_reason_required_when": "submission_truth == unavailable"
      }
    },
    "constraints": {
      "source_category": "contest-report"
    }
  },
  "wiki-hardware": {
    "required": [
      "id",
      "title",
      "type",
      "architectures",
      "tags",
      "confidence",
      "related",
      "sources",
      "aliases"
    ],
    "optional": [
      "reproducibility",
      "prerequisites",
      "blackwell_relevance",
      "evidence_basis",
      "version_sensitive"
    ],
    "constraints": {
      "type": "hardware",
      "id_prefix": "hw-"
    }
  },
  "wiki-technique": {
    "required": [
      "id",
      "title",
      "type",
      "architectures",
      "tags",
      "confidence",
      "reproducibility",
      "prerequisites",
      "related",
      "sources"
    ],
    "optional": [
      "aliases",
      "symptoms",
      "blackwell_relevance",
      "evidence_basis",
      "version_sensitive",
      "artifact_dir"
    ],
    "disallow_peer_of_artifact_dir": [
      "full_code_dir",
      "variants_dir",
      "code_path"
    ],
    "constraints": {
      "type": "technique",
      "id_prefix": "technique-",
      "reproducibility_minimum": "snippet"
    }
  },
  "wiki-pattern": {
    "required": [
      "id",
      "title",
      "type",
      "tags",
      "symptoms",
      "candidate_techniques",
      "related",
      "sources"
    ],
    "optional": [
      "architectures",
      "confidence",
      "blackwell_relevance",
      "version_sensitive"
    ],
    "constraints": {
      "type": "pattern",
      "id_prefix": "pattern-"
    }
  },
  "wiki-kernel": {
    "required": [
      "id",
      "title",
      "type",
      "architectures",
      "tags",
      "confidence",
      "reproducibility",
      "kernel_types",
      "languages",
      "related",
      "sources",
      "performance_claims"
    ],
    "optional": [
      "aliases",
      "prerequisites",
      "symptoms",
      "blackwell_relevance",
      "evidence_basis",
      "version_sensitive",
      "artifact_dir"
    ],
    "disallow_peer_of_artifact_dir": [
      "full_code_dir",
      "variants_dir",
      "code_path"
    ],
    "constraints": {
      "type": "kernel",
      "id_prefix": "kernel-",
      "reproducibility_minimum": "snippet"
    }
  },
  "wiki-language": {
    "required": [
      "id",
      "title",
      "type",
      "tags",
      "related",
      "sources",
      "reproducibility"
    ],
    "optional": [
      "architectures",
      "confidence",
      "aliases",
      "evidence_basis",
      "blackwell_relevance",
      "version_sensitive"
    ],
    "constraints": {
      "type": "language",
      "id_prefix": "lang-",
      "reproducibility_minimum": "snippet"
    }
  },
  "wiki-migration": {
    "required": [
      "id",
      "title",
      "type",
      "from_arch",
      "to_arch",
      "tags",
      "related",
      "sources",
      "blackwell_relevance"
    ],
    "optional": [
      "confidence",
      "reproducibility",
      "prerequisites",
      "version_sensitive"
    ],
    "constraints": {
      "type": "migration",
      "id_prefix": "migration-"
    }
  },
  "artifact-bundle-provenance": {
    "required": [
      "origin_url",
      "upstream_repo",
      "license",
      "retrieved_at",
      "asset_mode",
      "files"
    ],
    "optional": [
      "upstream_sha",
      "derived_from",
      "size_cap_truncated",
      "license_notice"
    ],
    "constraints": {
      "asset_mode": [
        "verbatim",
        "extracted",
        "derived"
      ],
      "derived_from_required_when": "asset_mode == derived",
      "upstream_sha_required_when": "asset_mode == verbatim"
    },
    "files_schema": {
      "required": [
        "local_path",
        "role",
        "mode",
        "sha256"
      ],
      "optional": [
        "upstream_path",
        "heading_path",
        "size_cap_truncated"
      ],
      "constraints": {
        "role": [
          "pr-diff",
          "upstream-file",
          "extracted-block",
          "derived-source",
          "approach-notes",
          "bench-record"
        ],
        "mode": [
          "verbatim",
          "extracted",
          "derived",
          "upstream-patch"
        ],
        "upstream_path_required_when": "mode in [verbatim, extracted] and upstream_sha present",
        "heading_path_required_when": "mode == extracted"
      }
    }
  },
  "inclusion-policy": {
    "required": [
      "cute-dsl",
      "triton"
    ],
    "lane_schema": {
      "required": [
        "description",
        "capture_criteria",
        "skip_criteria"
      ],
      "optional": [
        "examples"
      ]
    }
  },
  "core-prs": {
    "required": [
      "generated_by",
      "checksum_sha256",
      "sources",
      "prs"
    ],
    "prs_schema": {
      "required": [
        "id",
        "source_of_inclusion"
      ],
      "optional": [
        "skipped_reason"
      ],
      "constraints": {
        "source_of_inclusion": [
          "wiki-graph-closure",
          "contest-reference",
          "cute-dsl-tutorial",
          "triton-in-policy",
          "allowlist"
        ]
      }
    }
  },
  "version-sensitive-pointer": {
    "required": [
      "id"
    ],
    "optional": [
      "tool",
      "claim_valid_for",
      "last_verified_release",
      "last_verified_at"
    ],
    "constraints": {
      "id_prefix": "vs-"
    }
  },
  "version-claims-registry": {
    "required": [
      "claims"
    ],
    "claim_schema": {
      "required": [
        "id",
        "tool",
        "claim_valid_for",
        "last_verified_release",
        "last_verified_at",
        "applies_to",
        "source_ids"
      ],
      "optional": [
        "dev_branch_sha",
        "notes"
      ],
      "constraints": {
        "tool": [
          "triton",
          "cutlass",
          "cuda",
          "ptx",
          "cute-dsl",
          "cutile",
          "tilelang",
          "tilus",
          "jax-pallas"
        ],
        "applies_to_required_min": 1,
        "source_ids_required_min": 1,
        "id_prefix": "vs-",
        "dev_branch_sha_required_when": "claim_valid_for contains 'dev'"
      }
    }
  },
  "tool-versions-snapshot": {
    "required": [
      "tools"
    ],
    "tool_schema": {
      "required": [
        "tool",
        "upstream_checked_at",
        "releases"
      ],
      "constraints": {
        "tool": [
          "triton",
          "cutlass",
          "cuda",
          "ptx",
          "cute-dsl",
          "cutile",
          "tilelang",
          "tilus",
          "jax-pallas"
        ]
      }
    },
    "release_schema": {
      "required": [
        "name",
        "released_at",
        "channel"
      ],
      "optional": [
        "release_notes_url",
        "dev_branch_sha",
        "evidence_source_ids",
        "notes"
      ],
      "constraints": {
        "channel": [
          "stable",
          "rc",
          "dev"
        ],
        "dev_branch_sha_required_when": "channel == dev"
      }
    }
  },
  "pr-page-skipped-audit": {
    "required": [
      "rows"
    ],
    "row_schema": {
      "required": [
        "pr_id",
        "repo",
        "pr_number",
        "stage",
        "reason",
        "recorded_at"
      ],
      "constraints": {
        "stage": [
          "pre-fetch",
          "is-kernel-related"
        ]
      }
    },
    "constraints": {
      "sort_order": "rows sorted by (repo, pr_number) ascending; byte-stable across re-runs"
    }
  },
  "refresh-cutoff": {
    "required": [
      "cutoff_date"
    ],
    "optional": [
      "notes"
    ]
  },
  "refresh-search-results": {
    "required": [
      "cutoff_date",
      "repos"
    ],
    "repo_schema": {
      "required": [
        "repo_slug",
        "searched_at",
        "cutoff_date_used",
        "pr_numbers_seen",
        "last_pr_date_seen"
      ],
      "constraints": {
        "pr_numbers_seen_sort": "ascending integers"
      }
    }
  }
}
