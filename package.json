{
  "name": "kernel-wiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-contained Node.js query and corpus maintenance tools for the kernel-wiki Agent Skill.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "generate:indices": "node scripts/generate-indices.mjs",
    "generate:pr-pages": "node scripts/generate-pr-pages.mjs --all",
    "generate:core": "node scripts/compute-core-prs.mjs",
    "refresh:candidates": "node scripts/refresh-candidate-ledger.mjs",
    "check:dod": "node scripts/check-dod-fixtures.mjs",
    "check:core": "node scripts/verify-core-prs.mjs",
    "check:size": "node scripts/repo-size-check.mjs",
    "check:freshness": "node scripts/check-version-freshness.mjs",
    "check:blogs": "node scripts/extract-blog-code.mjs --check-all",
    "verify:verbatim": "node scripts/verify-verbatim.mjs --strict",
    "verify:architecture": "node scripts/verify-pr-architecture-upstream.mjs",
    "build:yaml": "node scripts/build-yaml-vendor.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "yaml": "^2.9.1"
  }
}
